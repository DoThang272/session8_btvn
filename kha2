create or replace  procedure check_stock_hi(
	p_id int,
	p_qty int
)
LANGUAGE plpgsql
as $$
DECLARE
	v_qty int;
	nameP varchar(100);
begin

	select quantity , product_name into v_qty, nameP
	from kha2.inventory 
	where product_id = p_id;

	if v_qty < p_qty then 
		raise exception 'San pham % khong du trong kho', nameP;
	else 
		raise notice 'San pham % du', nameP;
	end if;
end;
$$;
call check_stock_hi(5,2)
